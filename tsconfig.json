{
    "compilerOptions": {
        "target": "ES2020",
        "module": "Node16",
        "moduleResolution": "Node16",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "types": [
            "node",
            "@playwright/test"
        ],
        "skipLibCheck": true
    },
    "include": [
        "playwright.config.ts",
        "tests",
        "pages",
        "api",
        "fixtures",
        "utils"
    ]
}
