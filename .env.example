# Copy to .env.local and replace the credentials with the values for your test environment.
ORANGEHRM_BASE_URL=https://opensource-demo.orangehrmlive.com
ORANGEHRM_USERNAME=replace-with-test-username
ORANGEHRM_PASSWORD=replace-with-test-password
# Optional: set both values to enable Admin-versus-ESS role tests.
ORANGEHRM_ESS_USERNAME=
ORANGEHRM_ESS_PASSWORD=
EMPLOYEE_API_BASE_URL=https://reqres.in
# Optional when the API environment requires a key.
REQRES_API_KEY=
